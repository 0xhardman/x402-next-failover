{
  "name": "x402-next-failover",
  "version": "0.1.3",
  "description": "Automatic failover middleware for x402 payment facilitators in Next.js with timeout support",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "echo \"Tests coming soon\" && exit 0"
  },
  "keywords": [
    "x402",
    "payment",
    "facilitator",
    "failover",
    "middleware",
    "next.js",
    "edge-runtime",
    "coinbase",
    "blockchain"
  ],
  "author": "0xhardman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xhardman/x402-next-failover.git"
  },
  "peerDependencies": {
    "@coinbase/x402": ">=0.1.0",
    "next": ">=14.0.0",
    "x402-next": ">=0.1.0"
  },
  "devDependencies": {
    "@coinbase/x402": "^0.6.6",
    "@types/node": "^20.10.0",
    "next": "^15.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "undici-types": "^7.16.0",
    "x402-next": "^0.6.5"
  }
}
